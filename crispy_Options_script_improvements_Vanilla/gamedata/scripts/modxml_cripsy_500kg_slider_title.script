
function on_xml_read()
	RegisterScriptCallback("on_xml_read", function(xml_file_name, xml_obj)
		if xml_file_name == [[text\eng\ui_st_options.xml]]
		or xml_file_name == [[text\rus\ui_st_options.xml]]
		then
			local res = xml_obj:query("string[id=ui_mm_gameplay_gameplay_diff_weight] > text")
			if res[1] then
				el = res[1]
				local el_text = xml_obj:getText(el)
				if el_text then
					xml_obj:setText(el, el_text .. " 500kg Slider")
				end
			end
		end
	end)
end
