-- Load Ready 1.4.0 Clean | based on R1nk1 Load Ready
-- Anomaly 1.5.3 + full Modded Exes. Source baseline: 2026.8.17.
-- Original loading sequencer retained; optional native paired-key confirmation.
-- No vanilla file overrides, real emissions, or actor-update loop.
local VERSION = "1.4.0-clean"
local FALLBACK = "r1_load_ready\\ready"
local STATE_SECTION = "r1_load_ready"
local STATE_KEY = "first_ready_seen"
local opts = r1_load_ready_settings.read()
local registered, armed = false, false
local generation = 0
local catalog, entries
local current, current_path, current_kind, job, previous_path
local first_seen = false

local function log(message, important)
    if not important and not opts.debug then return end
    if type(printf) == "function" then
        printf("[R1-LOAD-READY] %s", tostring(message))
    end
end

local function exists(alias, name)
    local ok, result = pcall(function() return getFS():exist(alias, name) end)
    return ok and not not result
end

-- Reuse Anomaly's existing global options store; never create a mod state file.
local function save_first_state()
    local ok, err = pcall(function()
        if not axr_main or not axr_main.config then
            error("global options store unavailable")
        end
        local config = axr_main.config
        config:w_value(STATE_SECTION, STATE_KEY, true)
        -- The installed ini wrapper returns nil on success; explicit false fails.
        if config:save() == false then error("global options save failed") end
    end)
    if not ok then log("STATE_SAVE_FAILED " .. tostring(err), true) end
    return ok
end

local function read_first_state()
    local ok, seen = pcall(function()
        if not axr_main or not axr_main.config then
            error("global options store unavailable")
        end
        return axr_main.config:r_value(STATE_SECTION, STATE_KEY, 1, false)
    end)
    if not ok then
        first_seen = true -- suppress a greeting that cannot be remembered
        log("STATE_READ_FAILED; one-time greeting disabled", true)
        return
    end
    first_seen = seen == true
    -- Read-only migration: an old marker still counts as a consumed greeting.
    -- Keep the original file untouched; this build never creates it.
    if not first_seen and exists("$app_data_root$", "r1_load_ready_state.ltx") then
        first_seen = true
        save_first_state()
    end
end

local function consume_first_ready()
    if first_seen then return false end
    first_seen = true
    -- Reserve before playback, shared across saves, in existing global settings.
    if not save_first_state() then return false end
    log("FIRST_READY_CONSUMED (global options, outside savegame)")
    return true
end

local function stop_current(reason)
    if current then pcall(function() current:stop() end) end
    if current_path then log("STOP " .. tostring(reason) .. " sound=" .. current_path) end
    current, current_path, current_kind = nil, nil, nil
end

local function cancel_custom(reason)
    -- Cancel the snapshot too: applying settings cannot restart an old playlist.
    if job and job.is_custom then job = nil end
    if current_kind == "custom" then stop_current(reason) end
end

local function clock_ms()
    -- Continual real-time clock, not frozen by the press-any-key pause.
    return device():time_continual()
end

local function elapsed(now, before)
    local delta = now - before
    if delta < 0 then delta = delta + 4294967296 end
    return delta
end

local function ensure_catalog()
    if catalog then return end
    catalog = r1_load_ready_catalog.scan(log)
    entries = r1_load_ready_catalog.pool(catalog, opts)
    log(string.format("CATALOG files=%d first=%d voices=%d extra=%d pda=%d radio=%d custom=%d jokes=%d blowout=%d",
        catalog.listed, #catalog.first, #catalog.voices, #catalog.extra,
        #catalog.pda, #catalog.radio, #catalog.custom, #catalog.jokes, #catalog.blowout), true)

end

local function apply_entry_mode(for_load)
    -- Manual mode always keeps the normal prompt. Automatic mode uses the engine's
    -- native no-wait branch ONLY while a load is in progress. On affected older
    -- Modded Exes builds, r1_load_ready_autokey repairs the missing dismissed
    -- callback after entry. Outside loading we restore 1 so the cvar is never left
    -- persistently disabled by this addon.
    local wait = not (for_load and opts.enabled and opts.entry_mode == 1)
    local ok, err = pcall(function()
        get_console():execute("keypress_on_start " .. (wait and "1" or "0"))
    end)
    if not ok then log("ENTRY_OPTION_ERROR " .. tostring(err), true) end
end

local function read_options()
    opts = r1_load_ready_settings.read()
    if catalog then entries = r1_load_ready_catalog.pool(catalog, opts) end
end

local function screamer_entry()
    local name = opts.screamer_sound
    if name:find("\\", 1, true) then
        if exists("$game_sounds$", name .. ".ogg") then
            return {path = name, kind = "screamer"}
        end
    else
        -- Default exact basename. Other custom bare names are not silently guessed.
        if name == "blowout" then
            local e = r1_load_ready_catalog.choose(catalog.blowout, previous_path, math.random)
            if e then return {path = e.path, kind = "screamer"} end
        elseif exists("$game_sounds$", name .. ".ogg") then
            return {path = name, kind = "screamer"}
        end
    end
    log("SCREAMER_SOUND_MISSING " .. name .. "; using normal pool", true)
    return nil
end

local function select_entry(first)
    -- The first-ever readiness in voice mode has 100% greeting priority.
    -- Neither jokes nor the 1% screamer can steal it.
    if first and opts.mode == 1 then
        local e = r1_load_ready_catalog.choose(catalog.first, nil, math.random)
        if e then return e end
        log("FIRST_VANO_MISSING; greeting opportunity consumed, not deferred", true)
    end
    -- Exactly one 1/100 roll per eligible load, never once per frame.
    if opts.screamer and math.random(1, 100) == 1 then
        local e = screamer_entry()
        if e then return e end
    end
    local e = r1_load_ready_catalog.choose(entries or {}, previous_path, math.random)
    return e or {path = FALLBACK, kind = "fallback"}
end

local function play_entry(entry, skip_missing)
    local path = entry.path
    if not exists("$game_sounds$", path .. ".ogg") then
        if skip_missing then
            log("CUSTOM_SKIPPED_MISSING " .. path .. ".ogg", true)
            return false
        end
        log("MISSING " .. path .. ".ogg; trying bundled cue", true)
        path = FALLBACK
    end
    if not exists("$game_sounds$", path .. ".ogg") then
        log("FALLBACK_MISSING; notification skipped", true)
        return false
    end
    stop_current("next cue")
    local ok, err = pcall(function()
        current = sound_object(path)
        current_path = path
        current_kind = path == entry.path and entry.kind or "fallback"
        -- Feedback-backed 2D sound, so long radio files can be stopped.
        -- Nil owner does not borrow an actor/NPC pointer or produce an NPC voice event.
        current:play_at_pos(nil, vector():set(0, 0, 0), 0, sound_object.s2d)
        current.volume = opts.volume
    end)
    if not ok then
        log("PLAY_ERROR " .. tostring(err), true)
        stop_current("play error")
        return false
    end
    previous_path = path
    log("PLAY kind=" .. entry.kind .. " sound=" .. path .. " volume=" .. tostring(opts.volume), true)
    return true
end

local function finish_job(j)
    if job == j then job = nil end
    return true -- removes this one finite level.add_call entry
end

local function tick_playlist(j, now)
    -- One sound at a time; never native looping or concatenation. While a track
    -- is live, only query feedback every 100ms, including on the paused prompt.
    if j.track_active then
        if elapsed(now, j.checked_at) < 100 then return false end
        j.checked_at = now
        if elapsed(now, j.track_at) < 250 then return false end
        if current and current:playing() then return false end
        stop_current("custom track ended")
        j.track_active = false
    end

    local entry = j.playlist[j.next_index]
    if not entry then
        if j.played_count == 0 then
            log("CUSTOM_PLAYLIST_EMPTY; using bundled cue", true)
            play_entry({path=FALLBACK, kind="fallback"})
        else
            log("CUSTOM_PLAYLIST_COMPLETE tracks=" .. j.played_count, true)
        end
        return finish_job(j)
    end

    -- Advance BEFORE attempting playback. At most one failed file per tick;
    -- a folder of missing files cannot freeze a frame or retry indefinitely.
    local index = j.next_index
    j.next_index = index + 1
    if play_entry(entry, true) then
        j.track_active, j.track_at, j.checked_at = true, now, now
        j.played_count = j.played_count + 1
        log("CUSTOM_TRACK " .. index .. "/" .. #j.playlist, true)
    end
    return false
end

local function tick_job(j)
    if job ~= j or j.generation ~= generation then return true end
    if not opts.enabled then stop_current("disabled"); return finish_job(j) end
    local d, now = device(), clock_ms()
    if j.is_custom and j.dismissed and opts.custom_stop_on_entry then
        stop_current("custom stopped on gameplay entry")
        return finish_job(j)
    end
    if not j.started then
        -- The key-prompt callback is allowed at precache=2. Audio master volume is
        -- still zero then. Start on the first post-precache tick, BEFORE key input.
        if d.precache_frame ~= 0 then
            if elapsed(now, j.created) >= 60000 then
                log("PRECACHE_TIMEOUT; notification skipped", true)
                return finish_job(j)
            end
            return false
        end
        if j.playlist then
            j.started, j.started_at = true, now
            j.next_index, j.played_count = 1, 0
        else
            if not play_entry(j.entry) then return finish_job(j) end
            j.started, j.started_at, j.checked_at = true, now, now
            if j.dismissed then j.entry_at = now end
            -- A random Custom sound, like a voice cue, needs no monitoring
            -- unless the user requested stopping it at entry.
            if j.entry.kind ~= "radio" and not
                (j.is_custom and opts.custom_stop_on_entry) then return finish_job(j) end
        end
    end
    if j.playlist then return tick_playlist(j, now) end
    if j.is_custom then
        if elapsed(now, j.checked_at) < 100 then return false end
        j.checked_at = now
        if elapsed(now, j.started_at) >= 250 and (not current or not current:playing()) then
            stop_current("custom cue ended")
            return finish_job(j)
        end
        return false
    end
    -- Radio keeps its existing duration/tail policy; it does NOT cap Custom.
    if elapsed(now, j.started_at) >= opts.radio_limit * 1000 then
        stop_current("radio time limit")
        return finish_job(j)
    end
    if j.dismissed and elapsed(now, j.entry_at or now) >= opts.radio_tail * 1000 then
        stop_current("radio gameplay tail")
        return finish_job(j)
    end
    if elapsed(now, j.started_at) > 1000 and current and not current:playing() then
        return finish_job(j)
    end
    return false
end

local function schedule(j)
    local ok, err = pcall(function()
        level.add_call(function()
            local tick_ok, done = pcall(tick_job, j)
            if not tick_ok then
                log("TICK_ERROR " .. tostring(done), true)
                if job == j then stop_current("tick error"); job = nil end
                return true
            end
            return done == true
        end, function() end)
    end)
    if not ok then
        if job == j then job = nil end
        log("SCHEDULE_ERROR " .. tostring(err), true)
    end
end

local function is_actor(obj)
    return obj ~= nil and obj:clsid() == clsid.actor
end

function game_object_on_net_spawn(obj)
    if not is_actor(obj) then return end
    r1_load_ready_autokey.cancel("actor spawn")
    apply_entry_mode(true)
    generation = generation + 1
    job = nil
    armed = true
    stop_current("actor spawn")
    log("ARMED generation=" .. generation)
end

function game_object_on_net_destroy(obj)
    if not is_actor(obj) then return end
    r1_load_ready_autokey.cancel("actor destroy")
    generation = generation + 1
    armed, job = false, nil
    stop_current("actor destroy")
end

function on_loading_screen_key_prompt()
    if not armed then return end
    armed = false
    -- Entry and audio have separate finite jobs: mute/missing audio cannot block entry.
    r1_load_ready_autokey.begin(opts)
    local first = consume_first_ready()
    if not opts.enabled or opts.volume <= 0 then
        log("READY_SILENT (disabled or zero volume)")
        return
    end
    ensure_catalog()
    local entry = select_entry(first)
    local j = {generation=generation, entry=entry, created=clock_ms(),
        started=false, dismissed=false, is_custom=(entry.kind == "custom")}
    -- Extras are resolved once per load above. A selected joke/screamer replaces
    -- the Custom notification, rather than interrupting each playlist track.
    if j.is_custom and opts.custom_playback == 1 then
        j.playlist = {}
        for i, e in ipairs(catalog.custom) do
            j.playlist[i] = {path=e.path, kind="custom"}
        end
        log("CUSTOM_PLAYLIST_QUEUED tracks=" .. #j.playlist, true)
    end
    job = j
    log("READY generation=" .. generation .. " mode=" .. opts.mode .. " entry=" .. opts.entry_mode)
    schedule(j)
end

function on_loading_screen_dismissed()
    r1_load_ready_autokey.dismissed()
    -- Observes either the real engine dismissal callback or the 1.4 compatibility repair.
    if job then
        job.dismissed = true
        if job.started then job.entry_at = clock_ms() end
    end
end

function on_option_change()
    if not registered then return end
    r1_load_ready_autokey.cancel("settings changed")
    cancel_custom("settings changed")
    read_options()
    apply_entry_mode(false)
    r1_load_ready_autokey.prepare(log, opts)
    if not opts.enabled then stop_current("disabled in settings")
    elseif not catalog then ensure_catalog() end
end

function main_menu_on_init()
    if not registered then return end
    r1_load_ready_autokey.cancel("main menu")
    cancel_custom("main menu")
    read_options()
    apply_entry_mode(false)
    r1_load_ready_autokey.prepare(log, opts)
    if opts.enabled then ensure_catalog() end
end

function on_game_load()
    if not registered then return end
    -- Reassert before the engine starts its loading sequencer, not after it.
    read_options()
    apply_entry_mode(true)
end

function on_game_start()
    if registered then return end
    read_options()
    if type(rawget(_G, "OnLoadingScreenKeyPrompt")) ~= "function" or
        type(rawget(_G, "OnLoadingScreenDismissed")) ~= "function" then
        log("DISABLED: full Modded Exes callback bridge required (2026.8.17 baseline)", true)
        return
    end
    read_first_state()
    RegisterScriptCallback("on_loading_screen_key_prompt", on_loading_screen_key_prompt)
    RegisterScriptCallback("on_loading_screen_dismissed", on_loading_screen_dismissed)
    RegisterScriptCallback("game_object_on_net_spawn", game_object_on_net_spawn)
    RegisterScriptCallback("game_object_on_net_destroy", game_object_on_net_destroy)
    RegisterScriptCallback("on_option_change", on_option_change)
    RegisterScriptCallback("main_menu_on_init", main_menu_on_init)
    RegisterScriptCallback("on_game_load", on_game_load)
    registered, armed = true, true
    apply_entry_mode(false)
    r1_load_ready_autokey.prepare(log, opts)
    -- VFS index once during startup, not during gameplay or for every NPC.
    if opts.enabled then ensure_catalog() end
    log("INIT v" .. VERSION .. " first_seen=" .. tostring(first_seen), true)
end
