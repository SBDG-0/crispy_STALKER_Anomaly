; Load Ready 1.4.0. MCM values override these fallback defaults.
; entry_mode: 0 = wait for player; 1 = native no-wait entry + dismissed-callback compatibility repair.
; mode: 1 = voice / PDA conversations; 2 = PDA sound; 3 = radio (experimental); 4 = Custom.
[r1_load_ready]
entry_mode = 0
; Legacy 1.2/1.3 setting retained only for old MCM data; ignored by 1.4.0.
auto_delay = 0.35
enabled = true
mode = 1
volume = 0.85
extra_voice = false
; 0 = random; 1 = welcome; 2 = objective; 3 = sos; 4 = guide_2; 5 = news
pda_choice = 0
jokes = false
radio_channel_1 = true
radio_channel_2 = true
radio_playlist_1 = true
; Radio is single-shot, never looped. Tail seconds after entering gameplay.
radio_tail = 5
radio_limit = 120
; Custom reads every .ogg in sounds/r1_load_ready/custom (subfolders included).
; 0 = one random file per load; 1 = all files in alphabetical path order, once.
custom_playback = 0
; false = let Custom finish after entering gameplay; true = stop on entry.
; Radio tail/limit settings never truncate Custom.
custom_stop_on_entry = false
; 1 percent, once per loading screen. SOUND ONLY; no actual emission.
screamer = false
; Exact basename OR a relative sound path, with or without .ogg.
screamer_sound = blowout
debug = true
