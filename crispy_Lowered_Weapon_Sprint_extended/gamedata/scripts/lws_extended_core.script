-- Sprint Weapon Suite: rewrite of Lower Weapon Sprint Optimized 1.3.
-- Original: Skieppy; Spaicrab and Coverdrave. Original blacklist IDs retained.
local registered, failed, replaying = false, false, false
local blacklist, opts = {}, nil
local generation, item_id = 0, nil
local in_sprint, owned, manual = false, false, false
local manual_override
local grace_at, jam_at
local function now() return device():time_continual() end
local function recent(at, duration) return at and (now()-at)%4294967296 < duration end
local function log(err)
    if printf then printf("[Sprint Weapon Suite] %s",tostring(err)) end
end
local function actor() return db and db.actor end
local function item()
    local a=actor()
    if not a or not a:alive() then return nil end
    local w=a:active_item()
    return w and IsWeapon(w) and w or nil
end
local function idle(w) return w and (w:get_state()==0 or w:get_state()==3) end
local function zoomed(w)
    local cast=w and w.cast_Weapon and w:cast_Weapon()
    return cast and ((cast.IsZoomed and cast:IsZoomed()) or (cast.is_zoomed and cast:is_zoomed())) or false
end
local function menu()
    local a=actor()
    return not a or device():is_paused() or (a.is_talking and a:is_talking())
        or (ActorMenu and ActorMenu.IsShown and ActorMenu:IsShown())
        or (level.main_input_receiver and level.main_input_receiver()~=nil)
        or (a.active_slot and (a:active_slot()==8 or a:active_slot()==14))
end
local function section(w)
    if not w then return nil end
    local sec=w:section()
    if opts.apply_for_all_wpn_variations and ini_sys:line_exist(sec,"parent_section") then
        local parent=ini_sys:r_string(sec,"parent_section")
        if parent and parent~="" then return parent end
    end
    return sec
end
local function allowed(w)
    if not opts.auto_lower then return false end
    local sec=section(w)
    if not sec then return false end
    local listed=blacklist[sec]==true
    return listed==opts.reverse_blacklist
end
local function news(id)
    local a=actor()
    if a and a.give_game_news then
        a:give_game_news("Sprint Weapon Suite",game.translate_string(id),"ui_inGame2_D_Ohotnik_na_mutantov",0,5000,0)
    end
end
local function save_blacklist()
    if not (axr_main and axr_main.config) then return end
    local entries={}
    for sec in pairs(blacklist) do entries[#entries+1]=sec end
    table.sort(entries)
    axr_main.config:w_value("lower_weapon_sprint","blacklist",table.concat(entries,","))
    axr_main.config:save()
end
local function read_blacklist()
    blacklist={}
    local stored=axr_main and axr_main.config and axr_main.config:r_value("lower_weapon_sprint","blacklist",3,"") or ""
    for sec in tostring(stored):gmatch("[^,%s]+") do blacklist[sec]=true end
end
local function release_stance()
    local w=item()
    if owned and not manual and game.actor_weapon_lowered() then
        game.actor_lower_weapon(false)
        -- Let the engine blend out of safemode. Forcing idle here restarts
        -- the animation on sprint exit and cuts off its natural transition.
    end
    owned=false
end
local function reset()
    generation=generation+1
    release_stance()
    in_sprint,manual,replaying=false,false,false
    manual_override=nil
    item_id,grace_at,jam_at=nil,nil,nil
end
local function refresh()
    opts=lws_extended_mcm.read()
    if opts.clear_blacklist then
        blacklist={};save_blacklist()
        news("ui_lower_weapon_sprint_blacklist_cleared")
        if ui_mcm and ui_mcm.set then ui_mcm.set("crispy_lowered_weapons/lower_weapon_sprint/clear_blacklist",false) end
    end
    if not opts.auto_lower then release_stance() end
    failed=false
end
local function update()
    if failed then return end
    if not opts then refresh() end
    local a=actor()
    if not a or not a:alive() then reset();return end
    if menu() then return end
    local w=item()
    local sprint=IsMoveState("mcSprint") and not IsMoveState("mcCrouch") and not IsMoveState("mcClimb")
    local new_id=w and w:id()
    if new_id~=item_id then
        -- Invalidate delayed fire and do not transfer an auto-owned lowered
        -- stance or an old weapon pointer to the next item.
        release_stance()
        generation=generation+1
        item_id=new_id
        manual_override=nil
        manual=game.actor_weapon_lowered() and true or false
        grace_at,jam_at=nil,nil
    end
    if not sprint then
        if in_sprint then generation=generation+1 end
        release_stance()
        in_sprint=false
        manual_override=nil
        manual=game.actor_weapon_lowered() and true or false
        return
    end
    if not in_sprint then
        manual=game.actor_weapon_lowered() and true or false
        in_sprint=true
    end
    if manual_override~=nil then return end
    if not allowed(w) then release_stance();return end
    if zoomed(w) or not idle(w) or recent(grace_at,120) then return end
    if not game.actor_weapon_lowered() then game.actor_lower_weapon(true);owned=true end
end
local function safe_update()
    local ok,err=pcall(update)
    if not ok then pcall(release_stance);failed=true;log(err) end
end

-- Let the position module observe the final stance even if callback ordering
-- puts its actor-update handler before this module's handler.
function synchronize()
    if registered then safe_update() end
end

-- Wheel/key stance actions transfer ownership away from automatic lowering.
-- A raise stays raised for this sprint; a lower survives sprint exit.
function set_manual_stance(lowered)
    safe_update()
    local w=item()
    if not w or menu() then return false end
    generation=generation+1
    manual=lowered and true or false
    owned=false
    manual_override=nil
    if IsMoveState("mcSprint") then manual_override=manual end
    game.actor_lower_weapon(manual)
    return true
end

local function process_blacklist(expected_id)
    local w=item()
    if not w or menu() or (expected_id and w:id()~=expected_id) then return end
    local sec=section(w)
    if blacklist[sec] then blacklist[sec]=nil;news("ui_lower_weapon_sprint_blacklist_remove")
    else blacklist[sec]=true;news("ui_lower_weapon_sprint_blacklist_add") end
    save_blacklist()
    safe_update()
end
local function blacklist_key(key,hold)
    if not opts or key~=opts.keybind or menu() then return end
    local w=item()
    if not w then return end
    local id=w:id()
    local callback=function() process_blacklist(id) end
    if not (ui_mcm and ui_mcm.get_mod_key and ui_mcm.key_hold) then
        if not hold then callback() end
        return
    end
    if not ui_mcm.get_mod_key(opts.modifier) then return end
    if hold then
        if opts.mode==2 and ui_mcm.key_hold("lws_suite_blacklist",key,5) then callback() end
    elseif opts.mode==0 then
        if ui_mcm.simple_press then ui_mcm.simple_press("lws_suite_blacklist",key,callback) else callback() end
    elseif opts.mode==1 and ui_mcm.double_tap and ui_mcm.double_tap("lws_suite_blacklist",key) then callback() end
end
local function matches(key,name)
    return key_bindings and key_bindings[name] and bind_to_dik and key==bind_to_dik(key_bindings[name])
end
local function key_press(key)
    if replaying then return end
    if lwk_extended_core and lwk_extended_core.handled_key and lwk_extended_core.handled_key(key) then return end
    blacklist_key(key,false)
    local w=item()
    if not w or menu() or not allowed(w) then return end
    if matches(key,"kSAFEMODE") and idle(w) then
        manual_override=nil
        -- Retain the original key's manual-stance choice during a sprint.
        if in_sprint then manual=not manual else manual=not game.actor_weapon_lowered() end
    elseif matches(key,"kWPN_FIRE") then
        manual=false
        manual_override=nil
        if in_sprint and game.actor_weapon_lowered() then owned=true end
        grace_at=now()
        if not IsMoveState("mcSprint") or zoomed(w) or not idle(w) or recent(jam_at,100) then return end
        if w:get_ammo_in_magazine()==0 then return end
        if not game.actor_weapon_lowered() then return end
        local token,id=generation,w:id()
        game.actor_lower_weapon(false)
        w:switch_state(0)
        -- One guarded replay, like the original mod: never retain a userdata
        -- across the delayed callback, or replay after a load/weapon switch.
        if CreateTimeEvent then
            CreateTimeEvent("lws_suite_fire",0,0,function()
                local live=item()
                if token~=generation or not live or live:id()~=id or menu() or not allowed(live)
                    or not IsMoveState("mcSprint") or not idle(live) or zoomed(live)
                    or live:get_ammo_in_magazine()==0 or recent(jam_at,100) then return true end
                grace_at=now()
                replaying=true
                local ok,err=pcall(level.press_action,bind_to_dik(key_bindings.kWPN_FIRE))
                replaying=false
                if not ok then log(err) end
                return true
            end)
        end
    elseif matches(key,"kWPN_RELOAD") or matches(key,"kWPN_ZOOM") then
        manual=false
        manual_override=nil
        if in_sprint and game.actor_weapon_lowered() then owned=true end
        grace_at=now()
    end
end
local function safe_key(key)
    local ok,err=pcall(key_press,key)
    if not ok then replaying=false;log(err) end
end
local function key_hold(key)
    local ok,err=pcall(blacklist_key,key,true)
    if not ok then log(err) end
end
local function animation_end()
    -- The update callback checks the live weapon state after the engine's
    -- animation callback has finished, replacing the original 50-ms poll jobs.
    if in_sprint then grace_at=nil end
end
local function jammed() jam_at=now() end

function on_game_start()
    if registered then return end
    registered=true
    refresh();read_blacklist()
    RegisterScriptCallback("actor_on_update",safe_update)
    RegisterScriptCallback("actor_on_movement_changed",safe_update)
    RegisterScriptCallback("actor_on_hud_animation_end",animation_end)
    RegisterScriptCallback("actor_on_weapon_jammed",jammed)
    RegisterScriptCallback("on_key_press",safe_key)
    RegisterScriptCallback("on_key_hold",key_hold)
    RegisterScriptCallback("on_option_change",refresh)
    RegisterScriptCallback("on_game_load",reset)
    RegisterScriptCallback("main_menu_on_init",reset)
    RegisterScriptCallback("actor_on_before_death",reset)
    RegisterScriptCallback("actor_on_net_destroy",reset)
end

function on_game_end() reset() end
