# Keep only distribution sources and shared repository files at the root.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/crispy_*/
!/.github/

# Generated files, local configuration and credentials at any depth.
__pycache__/
*.py[cod]
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.log
*.tmp
*.bak
.DS_Store
Thumbs.db
